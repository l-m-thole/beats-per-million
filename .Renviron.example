# Copy this file to .Renviron (same folder) and fill in the keys you have.
# .Renviron is git-ignored: never commit real keys. Restart R after editing.
# Missing keys are fine - that feature/step is skipped.

# Spotify: Connect Spotify (in-app player), Save to Spotify, finding Spotify links
# https://developer.spotify.com/dashboard  (Redirect URI: http://127.0.0.1:4321/)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3: finding YouTube links (free, ~100 searches/day)
# https://console.cloud.google.com
YOUTUBE_API_KEY=

# GetSongBPM: filling blank bpm cells (free; requires a PUBLIC backlink to
# https://getsongbpm.com - see MUSIC_SETUP.md)  https://getsongbpm.com/api
GETSONGBPM_KEY=

# SoundCloud: finding SoundCloud links (optional; access by application)
# https://developers.soundcloud.com
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# App settings (optional; see R/settings.R). Locally you need none of these.
# deploy/deploy_shinyapps.R writes the server's values for you.
# ---------------------------------------------------------------------------
# "Play via" choice visitors start with: spotify | youtube
# (soundcloud only once SHOW_SOUNDCLOUD is TRUE in R/config.R)
# (a playlist only ever plays from that one service)
# BPM_DEFAULT_PLAYER=spotify
# Who sees "Connect Spotify": on | testers (only with ?testers in the URL) | off
# BPM_SPOTIFY_LOGIN=on
# Contact shown in About & privacy (email or URL)
# BPM_CONTACT=
# The app's public address, for link previews (deploy script sets it)
# BPM_PUBLIC_URL=https://beatspermillion.shinyapps.io/dance/
# Where "Suggest a song" points; empty = pre-filled email to BPM_CONTACT
# BPM_SUGGEST_URL=
# Spotify redirect for a deployed copy (the app's https:// address)
# SPOTIFY_REDIRECT_URI=
